{
  "manifest_version": 3,
  "name": "Boards — nuova scheda segnalibri",
  "description": "Segnalibri in board drag-and-drop sulla nuova scheda, con temi, sfondi, promemoria. Tutto in locale.",
  "version": "1.7.0",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "favicon",
    "alarms",
    "notifications"
  ],
  "optional_permissions": [
    "bookmarks",
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Salva nei segnalibri (Ctrl+B)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      },
      "description": "Salva la scheda aperta"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}